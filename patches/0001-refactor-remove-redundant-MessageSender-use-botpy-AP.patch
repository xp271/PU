From af682d11cdc2707de8afbb2e735e03dffecc7320 Mon Sep 17 00:00:00 2001
From: D <dxphhhh@outlook.com>
Date: Sun, 5 Jul 2026 18:04:25 +0800
Subject: [PATCH 1/3] refactor: remove redundant MessageSender, use botpy API
 directly

---
 src/agent_core/channels/qq_bot/channel.py | 13 +---
 src/agent_core/channels/qq_bot/sender.py  | 75 ------------------
 tests/unit/qq_bot/test_sender.py          | 94 -----------------------
 3 files changed, 4 insertions(+), 178 deletions(-)
 delete mode 100644 src/agent_core/channels/qq_bot/sender.py
 delete mode 100644 tests/unit/qq_bot/test_sender.py

diff --git a/src/agent_core/channels/qq_bot/channel.py b/src/agent_core/channels/qq_bot/channel.py
index 83ea7f4..7d54f4a 100644
--- a/src/agent_core/channels/qq_bot/channel.py
+++ b/src/agent_core/channels/qq_bot/channel.py
@@ -12,7 +12,6 @@ from typing import Any
 from agent_core.models import AgentConfig
 
 from .client import QQBotClient
-from .sender import MessageSender
 from .types import QQBotConfig
 
 logger = logging.getLogger("agent_core.qq_bot.channel")
@@ -38,7 +37,6 @@ class QQBotChannel:
     def __init__(self, config: QQBotConfig) -> None:
         self._config = config
         self._client: QQBotClient | None = None
-        self._sender: MessageSender | None = None
 
         base_agent_config = _load_global_agent_config()
         from agent_core.bridge.agent_bridge import AgentBridge
@@ -67,7 +65,6 @@ class QQBotChannel:
             _asyncio.set_event_loop(_loop)
             client = QQBotClient(self)
             self._client = client
-            self._sender = MessageSender(client.api)
             _loop.run_until_complete(client.start(
                 self._config.app_id, self._config.app_secret
             ))
@@ -94,13 +91,11 @@ class QQBotChannel:
             logger.exception(f"AgentBridge.process error for user {user_id}")
             replies = ["处理出错，请稍后再试。"]
 
-        sender = self._sender
-        if sender is None and self._client is not None:
-            sender = MessageSender(self._client.api)
+        api = self._client.api if self._client is not None else None
         for text in replies:
-            if sender is None:
+            if api is None:
                 continue
             if channel_id == "c2c":
-                await sender.send_c2c_text(user_id, text)
+                await api.post_c2c_message(openid=user_id, msg_type=0, content=text)
             else:
-                await sender.send_group_text(channel_id, text)
+                await api.post_group_message(group_openid=channel_id, msg_type=0, content=text)
diff --git a/src/agent_core/channels/qq_bot/sender.py b/src/agent_core/channels/qq_bot/sender.py
deleted file mode 100644
index 4d51dd8..0000000
--- a/src/agent_core/channels/qq_bot/sender.py
+++ /dev/null
@@ -1,75 +0,0 @@
-"""QQ 消息发送封装 — botpy API 的薄封装。
-
-支持文本、Markdown、图片等多种消息类型。
-"""
-
-from __future__ import annotations
-
-import logging
-from typing import TYPE_CHECKING
-
-if TYPE_CHECKING:
-    import botpy
-
-logger = logging.getLogger("agent_core.qq_bot.sender")
-
-
-class MessageSender:
-    """QQ 消息发送封装。
-
-    封装 botpy 的 HTTP API 调用，统一处理单聊/群聊的消息发送。
-    """
-
-    def __init__(self, api: "botpy.API") -> None:
-        self._api = api
-
-    async def send_c2c_text(self, openid: str, content: str) -> None:
-        """发送单聊文本消息（msg_type=0）。"""
-        try:
-            await self._api.post_c2c_message(
-                openid=openid,
-                msg_type=0,
-                content=content,
-            )
-        except Exception:
-            logger.exception(f"send_c2c_text failed for user {openid}")
-
-    async def send_group_text(self, group_openid: str, content: str) -> None:
-        """发送群聊文本消息（msg_type=0）。"""
-        try:
-            await self._api.post_group_message(
-                group_openid=group_openid,
-                msg_type=0,
-                content=content,
-            )
-        except Exception:
-            logger.exception(f"send_group_text failed for group {group_openid}")
-
-    async def send_c2c_markdown(
-        self, openid: str, template_id: str, params: dict[str, str]
-    ) -> None:
-        """发送单聊 Markdown 模板消息（msg_type=2）。
-
-        QQ 支持 Markdown 模板消息，需要先在开放平台配置模板。
-        """
-        try:
-            await self._api.post_c2c_message(
-                openid=openid,
-                msg_type=2,
-                markdown={"custom_template_id": template_id, "params": params},
-            )
-        except Exception:
-            logger.exception(f"send_c2c_markdown failed for user {openid}")
-
-    async def send_group_markdown(
-        self, group_openid: str, template_id: str, params: dict[str, str]
-    ) -> None:
-        """发送群聊 Markdown 模板消息（msg_type=2）。"""
-        try:
-            await self._api.post_group_message(
-                group_openid=group_openid,
-                msg_type=2,
-                markdown={"custom_template_id": template_id, "params": params},
-            )
-        except Exception:
-            logger.exception(f"send_group_markdown failed for group {group_openid}")
diff --git a/tests/unit/qq_bot/test_sender.py b/tests/unit/qq_bot/test_sender.py
deleted file mode 100644
index be1d249..0000000
--- a/tests/unit/qq_bot/test_sender.py
+++ /dev/null
@@ -1,94 +0,0 @@
-"""Tests for qq_bot/sender.py — MessageSender."""
-
-from __future__ import annotations
-
-from unittest.mock import AsyncMock, MagicMock, patch
-
-import pytest
-
-from agent_core.channels.qq_bot.sender import MessageSender
-
-
-@pytest.fixture
-def api():
-    """Mock botpy.API."""
-    mock = AsyncMock()
-    mock.post_c2c_message = AsyncMock()
-    mock.post_group_message = AsyncMock()
-    return mock
-
-
-@pytest.fixture
-def sender(api):
-    return MessageSender(api)
-
-
-class TestMessageSender:
-    """MessageSender 消息发送测试。"""
-
-    @pytest.mark.asyncio
-    async def test_send_c2c_text(self, sender, api):
-        """send_c2c_text 应调用 post_c2c_message。"""
-        await sender.send_c2c_text("user1", "你好")
-
-        api.post_c2c_message.assert_called_once_with(
-            openid="user1",
-            msg_type=0,
-            content="你好",
-        )
-
-    @pytest.mark.asyncio
-    async def test_send_group_text(self, sender, api):
-        """send_group_text 应调用 post_group_message。"""
-        await sender.send_group_text("g123", "大家好")
-
-        api.post_group_message.assert_called_once_with(
-            group_openid="g123",
-            msg_type=0,
-            content="大家好",
-        )
-
-    @pytest.mark.asyncio
-    async def test_send_c2c_text_error_handled(self, sender, api):
-        """发送失败不抛异常（错误被记录但不传播）。"""
-        api.post_c2c_message.side_effect = RuntimeError("network error")
-
-        # 不应抛异常
-        await sender.send_c2c_text("user1", "test")
-
-        api.post_c2c_message.assert_called_once()
-
-    @pytest.mark.asyncio
-    async def test_send_group_text_error_handled(self, sender, api):
-        """群聊发送失败不抛异常。"""
-        api.post_group_message.side_effect = RuntimeError("network error")
-
-        await sender.send_group_text("g123", "test")
-
-        api.post_group_message.assert_called_once()
-
-    @pytest.mark.asyncio
-    async def test_send_c2c_markdown(self, sender, api):
-        """send_c2c_markdown 发送模板消息。"""
-        await sender.send_c2c_markdown(
-            "user1", "tpl_001", {"title": "Hello"}
-        )
-
-        api.post_c2c_message.assert_called_once_with(
-            openid="user1",
-            msg_type=2,
-            markdown={"custom_template_id": "tpl_001", "params": {"title": "Hello"}},
-        )
-
-    @pytest.mark.asyncio
-    async def test_send_group_markdown(self, sender, api):
-        """send_group_markdown 发送群聊模板消息。"""
-        await sender.send_group_markdown(
-            "g123", "tpl_002", {"content": "Hi"}
-        )
-
-        api.post_group_message.assert_called_once_with(
-            group_openid="g123",
-            msg_type=2,
-            markdown={"custom_template_id": "tpl_002", "params": {"content": "Hi"}},
-        )
